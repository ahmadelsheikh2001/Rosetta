// ======================================================================
// Bot:         02-control-flow
// Source:      02-control-flow/bot.json (Automation Anywhere A360)
// Converted:   2026-10-29T00:00:00.000Z
// Generator:   RPA Rosetta 0.0.0
// Inputs:      vTextIn (String), vNumIn (Numeric)
// Outputs:     vResult (String)
// Status:      DRAFT - syntax from the IBM RPA 30.0.x reference, being verified in Studio 30.0.2
// ======================================================================
defVar --name SampleNumber --type Numeric
defVar --name SampleString --type String
defVar --name vTextIn --type String --value "Test User" --parameter
defVar --name vResult --type String --value "none" --output
defVar --name vItem --type String
defVar --name vKey --type String
defVar --name vNumIn --type Numeric --value 7 --parameter
defVar --name vCounter --type Numeric --value 0
defVar --name vFlag --type Boolean --value True
defVar --name vList --type List --innertype String --value "[Alpha,Skip,Gamma]"
defVar --name vDict --type StringDictionary --innertype String
defVar --name vFileInfo --type StringDictionary --innertype String
// ---- Helper variables added by the conversion ----
defVar --name rosettaEntry1 --type StringKeyValuePair --innertype String
defVar --name rosettaItem2 --type String
defVar --name rosettaItem3 --type String
defVar --name rosettaItem4 --type String
// ---- Initial values ----
strDictAdd --key "k1" --value "v1" --dictionary ${vDict}
strDictAdd --key "k2" --value "v2" --dictionary ${vDict}
// ---- Nested conditions ----
// RR_02: nested If / Else If / Else on Number, String and Boolean
if --left "${vNumIn}" --operator "Greater_Than" --right 5
if --left "${vTextIn}" --operator "Equal_To" --right "Test User"
setVar --name "${vResult}" --value "Number above 5 and text matches"
else
setVar --name "${vResult}" --value "Number above 5 but text differs"
endIf
elseIf --left "${vFlag}" --operator "Is_True"
setVar --name "${vResult}" --value "Flag is true"
else
setVar --name "${vResult}" --value "Else branch reached"
endIf
// ---- Loops ----
// RR_02: loop types, with Break and Continue under If
for --variable ${vCounter} --from 1 --to 5 --step 1
if --left "${vCounter}" --operator "Equal_To" --right 3
break
endIf
next
while --left "${vCounter}" --operator "Less_Than" --right 10
incrementVar --number ${vCounter}
endWhile
foreach --collection "${vList}" --variable "${vItem}"
if --left "${vItem}" --operator "Equal_To" --right "Skip"
continue
endIf
setVar --name "${vResult}" --value "Processed ${vItem}"
endFor
foreach --collection "${vDict}" --variable "${rosettaEntry1}"
setVar --name "${vKey}" --value "${rosettaEntry1.Key}"
strDictGet --key "${vKey}" --dictionary ${vDict} rosettaItem2=value
setVar --name "${vResult}" --value "Key ${vKey} has value ${rosettaItem2}"
endFor
