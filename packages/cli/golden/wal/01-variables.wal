// ======================================================================
// Bot:         01-variables
// Source:      01-variables/bot.json (Automation Anywhere A360)
// Converted:   2026-10-29T00:00:00.000Z
// Generator:   RPA Rosetta 0.0.0
// Inputs:      vStr (String)
// Outputs:     vNum (Numeric)
// Status:      DRAFT - syntax from the IBM RPA 30.0.x reference, being verified in Studio 30.0.2
// ======================================================================
defVar --name SampleNumber --type Numeric
defVar --name SampleString --type String
defVar --name vStr --type String --value "Test User" --parameter
defVar --name vNum --type Numeric --value 12345 --output
defVar --name vBool --type Boolean --value True
defVar --name vDate --type DateTime
defVar --name vList --type List --innertype String --value "[Alpha,Beta]"
defVar --name vDict --type StringDictionary --innertype String
defVar --name vTable --type DataTable
defVar --name vCred --type SecureString
// ---- Helper variables added by the conversion ----
defVar --name rosettaItem1 --type String
defVar --name rosettaItem2 --type String
defVar --name rosettaItem3 --type String
defVar --name rosettaItem4 --type String
// ---- Initial values ----
strDictAdd --key "name" --value "Test User" --dictionary ${vDict}
strDictAdd --key "city" --value "Test City" --dictionary ${vDict}
// ---- Assign new values ----
// RR_01: assign a new value to each variable type
setVar --name "${vStr}" --value "Updated Test User"
setVar --name "${vNum}" --value 100
evaluate --expression "${vNum} + 5" vNum=value
setVar --name "${vBool}" --value False
add --collection "${vList}" --value "${vStr}"
strDictAdd --key "country" --value "Testland" --dictionary ${vDict}
// ---- Show and log values ----
// RR_01: display and log selected variables
get --collection "${vList}" --index 1 rosettaItem1=value
strDictGet --key "name" --dictionary ${vDict} rosettaItem2=value
messageBox --title "RR_01 Variables" --text "vStr=${vStr} | vNum=${vNum} | vBool=${vBool} | first item=${rosettaItem1} | name=${rosettaItem2}" --icon "Information" --buttons "OK" --defaultbutton "FirstButton"
strDictGet --key "city" --dictionary ${vDict} rosettaItem3=value
get --collection "${vList}" --index 2 rosettaItem4=value
writeToFile --value "vStr=${vStr} | vNum=${vNum} | city=${rosettaItem3} | item1=${rosettaItem4}" --file "C:\\RosettaTest\\log.txt" --encoding "Default" --writeasnewline
writeToFile --value "vBool=${vBool} | vDate=${vDate} | vNum=${vNum} | vStr=${vStr}" --file "C:\\RosettaTest\\log.txt" --encoding "Default" --writeasnewline
// [DISABLED] messageBox --title "Automation Anywhere Enterprise Client" --text "This action is disabled on purpose" --icon "Information" --buttons "OK" --defaultbutton "FirstButton"
