// ======================================================================
defVar --name SampleNumber --type Numeric
defVar --name SampleString --type String
defVar --name vFilePath --type String --value "C:\\RosettaTest\\missing.txt" --parameter
defVar --name vStatus --type String --value "not started" --output
defVar --name vErrMsg --type String
defVar --name vOuterErr --type String
defVar --name vErrLine --type Numeric --value 0
defVar --name vDoThrow --type Boolean --value True
defVar --name vFileTable --type DataTable
// ---- Helper variables added by the conversion ----
defVar --name rosettaTry1Failed --type Boolean
defVar --name rosettaTry2Failed --type Boolean
// ---- Try Catch Finally ----
// RR_04: outer Try with nested inner Try, Catch, Throw and Finally
setVar --name "${rosettaTry1Failed}" --value False
goSub --label Try1
// A360 Finally: runs after the protected block, with or without an error
writeToFile --value "cleanup done" --file "C:\\RosettaTest\\log.txt" --encoding "Default" --writeasnewline
setVar --name "${vStatus}" --value "finished"
// A360 Finally end
// ---- Wrap up ----
// RR_04: wrap up after error handling
// [DISABLED] messageBox --title "Automation Anywhere Enterprise Client" --text "Disabled on purpose: status=${vStatus} inner=${vErrMsg} outer=${vOuterErr}" --icon "Information" --buttons "OK" --defaultbutton "FirstButton"
// ---- Subroutines added by the conversion (A360 Try/Catch) ----
beginSub --name Try1
// A360 Try (ErrorHandler/try @ 1.2)
onError --label Catch1
setVar --name "${rosettaTry2Failed}" --value False
goSub --label Try2
onError --label Catch1
if --left "${rosettaTry1Failed}" --operator "Is_True"
return
endIf
if --left "${vDoThrow}" --operator "Is_True"
failTest --message "Custom RR_04 error thrown on purpose"
if --left "${rosettaTry1Failed}" --operator "Is_True"
return
endIf
endIf
endSub
beginSub --name Try2
// A360 Try (ErrorHandler/try @ 1.2.1)
onError --label Catch2
// CSV session "Default" opened here; WAL reads the file in one step (readCSV) below.
readCSV --filepath "${vFilePath}" --delimiter "," vFileTable=value
if --left "${rosettaTry2Failed}" --operator "Is_True"
return
endIf
endSub
beginSub --name Catch2
// A360 Catch (BotException)
setVar --name "${rosettaTry2Failed}" --value True
setVar --name "${vErrMsg}" --value "${rpa:errorMessage}"
setVar --name "${vErrLine}" --value ${rpa:errorLineNumber}
writeToFile --value "Inner catch: ${vErrMsg} (line ${vErrLine})" --file "C:\\RosettaTest\\log.txt" --encoding "Default" --writeasnewline
recover
endSub
beginSub --name Catch1
// A360 Catch (BotException)
setVar --name "${rosettaTry1Failed}" --value True
setVar --name "${vOuterErr}" --value "${rpa:errorMessage}"
setVar --name "${vErrLine}" --value ${rpa:errorLineNumber}
writeToFile --value "Outer catch: ${vOuterErr} (line ${vErrLine})" --file "C:\\RosettaTest\\log.txt" --encoding "Default" --writeasnewline
recover
endSub
