{
  "name": "rpa-rosetta",
  "version": "0.0.0",
  "private": true,
  "description": "Converts RPA bots between platforms (A360 → IBM RPA first) via a vendor-neutral IR.",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "clean": "tsc -b --clean",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "prettier --check . && eslint . && tsc -b && vitest run",
    "scan:corpus": "node scripts/scan-corpus.mjs --all",
    "prepare": "husky",
    "rosetta": "node packages/cli/dist/main.js",
    "ui": "node packages/cli/dist/main.js serve",
    "preview:report": "tsc -b && node packages/cli/dist/main.js preview-report"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
