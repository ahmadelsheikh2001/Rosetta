defVar --name vAttId --type String
defVar --name vStatus --type String
defVar --name vCompany --type String
defVar --name vAddress --type DataTable
defVar --name vFields --type StringDictionary --innertype String
// ---- Helper variables added by the conversion ----
defVar --name rosettaSnBaseSN --type String
defVar --name rosettaSnHeadersSN --type StringDictionary --innertype String
defVar --name rosettaSnTokenSN --type String
